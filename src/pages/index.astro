---
import Base from '../layouts/Base.astro';
import FieldArt from '../components/FieldArt.astro';
import Icon from '../components/Icon.astro';
import PubItem from '../components/PubItem.astro';
import { researchAreas, currentPeople, publications, url } from '../lib/data';

const pi = currentPeople.find((p) => p.category === 'pi');
const recent = [...publications].sort((a, b) => Number(!!b.featured) - Number(!!a.featured) || b.year - a.year).slice(0, 3);
---
<Base>
  <!-- Hero -->
  <section class="hero on-dark" style={`--hero-image: url('${url('/img/hero-placeholder.jpeg')}')`}>
    <div class="wrap hero__inner">
      <div class="eyebrow rise">Weed Science · Mississippi State University</div>
      <h1 class="rise-2">Science-driven<br />weed management<br /><span>for modern farms</span></h1>
      <p class="hero__lede rise-3">We study how herbicides work, where weeds grow, and how to control them precisely — combining herbicide physiology, remote sensing, and application technology.</p>
      <div class="btn-row rise-3">
        <a class="btn" href={url('/research/')}>Explore research <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href={url('/people/')}>Meet the team</a>
      </div>
    </div>
  </section>

  <!-- What we do -->
  <section class="section">
    <div class="wrap">
      <div class="head head--center"><div class="eyebrow">What we do</div><h2>Research Areas</h2></div>
      <ul class="areas">
        {researchAreas.map((a) => (
          <li><a href={url(`/research/#${a.id}`)}>
            <span class="card__icon"><Icon name={a.icon} /></span>
            <strong>{a.title}</strong>
            <span>{a.blurb}</span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Mission and PI message -->
  <section class="section bg-stone">
    <div class="wrap message">
      <figure class="portrait">
        <img src={url('/img/people/luis-avila-portrait.jpg')} alt={`Portrait of ${pi.name}`} width="960" height="1200" loading="lazy" />
      </figure>
      <div>
        <div class="eyebrow">Our mission</div>
        <h2>Our mission &amp; a message from our PI</h2>
        <div class="letter">
          <p>Weeds are among the most adaptable organisms in agriculture. Sooner or later, they learn to escape every tool we give growers. That is why our lab follows a herbicide all the way from the spray nozzle to its target site in the plant and into the soil, and why we pair that understanding with drones, remote sensing, and machine learning. Our mission is simple to state and hard to achieve: weed management that keeps working for growers in the Mid-South and beyond.</p>
          <p>I believe good science starts in the field. The questions that matter most come from the people who farm, and our answers only count when they hold up on a real farm, not just in our data. Leaving an impact on agriculture means respecting the land, the grower's livelihood, and the generation that will inherit both.</p>
          <p>As a mentor, my door is open. I give students real ownership of their projects and the support to see them through: honest feedback, room to make mistakes, and the freedom to chase a good idea. I want everyone who trains here to leave as an independent scientist, a clear communicator, and a generous colleague. Careers are long, and character and curiosity will carry you further than any single result.</p>
          <p>If you are driven by curiosity and want your work to matter to the people who feed us, I would love to hear from you.</p>
        </div>
        <p class="signature">
          <a href={url(`/people/${pi.slug}/`)}>{pi.name}</a>
          <span>{pi.role}</span>
        </p>
        <div class="btn-row message__links">
          <a class="btn btn--line" href={url('/people/')}>Meet the team <Icon name="arrow" /></a>
          <a class="link" href={url('/research/')}>View all research <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Publications -->
  <section class="section">
    <div class="wrap narrow">
      <div class="head head--center"><div class="eyebrow">Publications</div><h2>Recent work</h2></div>
      <ul class="pub-list">{recent.map((p) => <PubItem pub={p} />)}</ul>
      <div class="center more"><a class="btn btn--line" href={url('/publications/')}>All publications <Icon name="arrow" /></a></div>
    </div>
  </section>

  <!-- Join -->
  <section class="section on-dark cta">
    <FieldArt />
    <div class="wrap" style="position:relative">
      <div class="eyebrow">Join the lab</div>
      <h2>Grow with us</h2>
      <p>We recruit MS and PhD students in weed science, application technology, and digital agriculture, and summer interns each year.</p>
      <div class="btn-row">
        <a class="btn" href={url('/opportunities/')}>Open positions <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href={url('/contact/')}>Get in touch</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; min-height: min(88vh, 820px); display: flex; align-items: center;
    background-image: linear-gradient(90deg, rgba(46,11,18,.9) 0%, rgba(46,11,18,.72) 42%, rgba(46,11,18,.42) 100%), var(--hero-image);
    background-position: center;
    background-size: cover; }
  .hero__inner { position: relative; z-index: 1; width: min(100%, 780px); margin-left: max(0px, calc((100% - var(--max)) / 2)); margin-right: 0; padding-top: 96px; padding-bottom: 96px; }
  .hero h1 { font-size: clamp(2.25rem, 5vw, 4rem); font-weight: 900; font-stretch: 125%; line-height: .98; letter-spacing: -.005em; margin-bottom: 28px; }
  .hero h1 span { color: var(--accent-300); }
  .hero__lede { max-width: 48ch; font-size: 1.125rem; color: var(--accent-200); margin-bottom: 36px; }

  .areas { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; }
  .areas li + li { border-left: 1px solid var(--rule); }
  .areas a { display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 28px 22px 30px; color: var(--ink); transition: background .25s var(--ease); }
  .areas a:hover { background: var(--accent-50); color: var(--ink); }
  .areas strong { font-size: 1rem; line-height: 1.3; }
  .areas a > span:last-child { font-size: .8125rem; color: var(--muted); line-height: 1.55; }
  @media (max-width: 1000px) {
    .hero__inner { margin-left: 0; }
    .areas { grid-template-columns: repeat(2, 1fr); }
    .areas li + li { border-left: 0; }
    .areas li { border-top: 1px solid var(--rule); }
    .areas li:nth-child(-n+2) { border-top: 0; }
    .areas li:nth-child(even) { border-left: 1px solid var(--rule); }
  }
  @media (max-width: 560px) { .areas { grid-template-columns: 1fr; } .areas li:nth-child(even) { border-left: 0; } .areas li:nth-child(2) { border-top: 1px solid var(--rule); } }

  .message { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(48px, 7vw, 104px); align-items: start; }
  .message h2 { margin-bottom: 28px; }
  /* Photo in a white mat, with an offset maroon outline behind it. */
  .portrait { position: sticky; top: 112px; margin: 0 22px 22px 0; }
  .portrait::before { content: ''; position: absolute; inset: 22px -22px -22px 22px; border: 2px solid var(--maroon); border-radius: 22px; }
  .portrait img { position: relative; display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border: 10px solid var(--white); border-radius: 22px;
    box-shadow: 0 36px 70px -36px rgba(46,11,18,.55); }
  .letter { color: var(--ink-2); font-size: 1.0625rem; max-width: 62ch; }
  .letter p:first-child::first-letter { float: left; font: 900 3.4rem/.9 var(--font-display); color: var(--maroon); margin: 6px 10px 0 0; }
  .signature { display: grid; gap: 2px; margin: 32px 0 0; padding-top: 24px; border-top: 1px solid var(--rule); max-width: 62ch; }
  .signature a { font: 800 1.25rem/1.3 var(--font-display); font-stretch: 112%; color: var(--ink); }
  .signature a:hover { color: var(--maroon); }
  .signature span { font-size: .875rem; color: var(--muted); }
  .message__links { margin-top: 32px; align-items: center; gap: 24px; }
  @media (max-width: 900px) {
    .message { grid-template-columns: 1fr; }
    .portrait { position: relative; top: 0; max-width: 380px; }
  }

  .cta { padding: clamp(88px, 11vw, 140px) 0; background: radial-gradient(120% 140% at 50% 0%, var(--deep-3), var(--deep) 65%); }
</style>
