---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { researchAreas, projects, url, inlineMd, clean } from '../../lib/data';
---
<Base title="Research" description="Research areas and projects of the Bala Lab — herbicide physiology, precision weed management, application technology, environmental fate, and alternative weed control.">
  <PageHero eyebrow="Research" title="From the nozzle to the soil"
    lede="We follow a herbicide from the spray nozzle to its target site in the plant and into the soil, and use that understanding to design weed management that stays effective." />

  <section class="section">
    <div class="wrap">
      <div class="head"><div class="eyebrow">Research areas</div><h2>What we study</h2></div>
      <div class="grid grid-3">
        {researchAreas.map((a, i) => (
          <article class="card" id={a.id}>
            <span class="card__icon"><Icon name={a.icon} /></span>
            <span class="card__meta">Area 0{i + 1}</span>
            <h3>{a.title}</h3>
            <div class="area-text" set:html={`<p>${inlineMd(clean(a.description))}</p>`} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-stone" id="projects">
    <div class="wrap">
      <div class="head"><div class="eyebrow">Projects</div><h2>Current work</h2></div>
      <div class="grid grid-3">
        {projects.map((p) => (
          <a class="card" href={url(`/research/projects/${p.slug}/`)}>
            <span class="card__meta">{p.status} · {p.start}{p.end ? `–${p.end}` : '–present'}</span>
            <h3>{p.title}</h3>
            <p>{p.summary}</p>
            <span class="card__foot link">Read more <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .area-text :global(p) { margin: 0; color: var(--ink-2); font-size: .9375rem; }
</style>
