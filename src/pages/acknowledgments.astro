---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { sponsors } from '../lib/data';
// Entries still marked TODO in sponsors.yml stay hidden until they are filled in.
const groups = sponsors
  .map((g) => ({ ...g, items: g.items.filter((s: any) => !/^TODO/.test(s.name)) }))
  .filter((g) => g.items.length);
---
<Base title="Acknowledgments" description="Sponsors, funders, partners, and donors who support the Bala Lab's research at Mississippi State University.">
  <PageHero eyebrow="Acknowledgments" title="With gratitude"
    lede="Our research, students, and outreach are supported by public agencies, commodity organizations, industry partners, and generous donors." />
  {groups.map((g, i) => (
    <section class:list={['section', i % 2 === 1 && 'bg-stone']}>
      <div class="wrap">
        <div class="head"><div class="eyebrow">Support</div><h2>{g.group}</h2></div>
        <div class="grid grid-3">
          {g.items.map((s: any) => {
            const Tag = s.url ? 'a' : 'div';
            return <Tag class="card" href={s.url || undefined}><h3>{s.name}</h3>{s.note && <p>{s.note}</p>}</Tag>;
          })}
        </div>
      </div>
    </section>
  ))}
  <section class="section">
    <div class="wrap center">
      <p class="muted">To support graduate students and field research, give through the <a href="https://www.msufoundation.com">MSU Foundation</a> or <a href="mailto:lad425@msstate.edu">contact the lab</a>.</p>
    </div>
  </section>
</Base>
