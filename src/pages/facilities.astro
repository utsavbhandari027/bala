---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { facilities, clean } from '../lib/data';
---
<Base title="Facilities" description="Laboratory, greenhouse, field research sites, and application technology used by the Bala Lab.">
  <PageHero eyebrow="Facilities" title="Where the work happens" lede="Laboratory, greenhouse, field, and application-technology resources that support our research." />
  {facilities.map((g, i) => (
    <section class:list={['section', i % 2 === 1 && 'bg-stone']}>
      <div class="wrap">
        <div class="head"><div class="eyebrow">0{i + 1}</div><h2>{g.group}</h2></div>
        <div class="grid grid-3">
          {g.items.map((f: any) => <article class="card"><h3>{f.name}</h3><p>{clean(f.description)}</p></article>)}
        </div>
      </div>
    </section>
  ))}
</Base>
