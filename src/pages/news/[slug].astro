---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { news, url, fmtDate } from '../../lib/data';
export function getStaticPaths() { return news.map((n) => ({ params: { slug: n.slug }, props: { n } })); }
const { n } = Astro.props as { n: any };
const { Content } = n;
---
<Base title={n.title} description={n.summary}>
  <PageHero eyebrow={`${fmtDate(n.date, true)} · ${n.category.replace('-', ' ')}`} title={n.title} back={{ label: 'News', href: url('/news/') }} />
  <article class="section">
    <div class="wrap narrow prose" style="font-size:1.0625rem"><Content /></div>
  </article>
</Base>
