---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { news, url, fmtDate } from '../../lib/data';
---
<Base title="News" description="News from the Bala Lab at Mississippi State University.">
  <PageHero eyebrow="News" title="From the lab" lede="Publications, conferences, field days, and new members." />
  <section class="section">
    <div class="wrap">
      <div class="grid grid-3">
        {news.map((n) => (
          <a class="card" href={url(`/news/${n.slug}/`)}>
            <span class="card__meta"><time datetime={n.date.toISOString()}>{fmtDate(n.date)}</time> · {n.category.replace('-', ' ')}</span>
            <h3>{n.title}</h3>
            <p>{n.summary}</p>
            <span class="card__foot link">Read <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
