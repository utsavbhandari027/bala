---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { openings, clean } from '../lib/data';
---
<Base title="Join the lab" description="Graduate assistantships, internships, and how to join the Bala Lab at Mississippi State University.">
  <PageHero eyebrow="Join the lab" title="Grow your career in weed science"
    lede="We recruit MS and PhD students in weed science, application technology, and digital agriculture, and summer interns each year." />
  <section class="section">
    <div class="wrap">
      <div class="head"><div class="eyebrow">Open positions</div><h2>Current openings</h2></div>
      {openings.length ? (
        <div class="grid grid-2">
          {openings.map((o) => {
            const reqs = (o.requirements ?? []).map(clean).filter(Boolean);
            return (
              <article class="card">
                <span class="card__meta">{o.level}{o.start && ` · Starts ${o.start}`}</span>
                <h3>{o.title}</h3>
                {clean(o.description) && <p>{clean(o.description)}</p>}
                {reqs.length > 0 && <p><strong>Requirements:</strong> {reqs.join('; ')}</p>}
                {o.apply && <p class="card__foot muted">{o.apply}</p>}
              </article>
            );
          })}
        </div>
      ) : <p class="muted">No open positions right now — prospective students are always welcome to get in touch.</p>}
    </div>
  </section>
  <section class="section bg-stone">
    <div class="wrap narrow">
      <div class="head"><div class="eyebrow">How to apply</div><h2>Prospective students</h2></div>
      <div class="prose">
        <p>Email <a href="mailto:lad425@msstate.edu">lad425@msstate.edu</a> with your CV, unofficial transcripts, and a short statement of your research interests. Admission is through the <a href="https://www.grad.msstate.edu">MSU Graduate School</a> and the <a href="https://www.pss.msstate.edu">Plant and Soil Sciences</a> graduate program.</p>
      </div>
    </div>
  </section>
</Base>
