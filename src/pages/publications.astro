---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PubItem from '../components/PubItem.astro';
import { publications } from '../lib/data';
const years = [...new Set(publications.map((p) => p.year))];
---
<Base title="Publications" description="Peer-reviewed articles, reviews, and extension publications from the Bala Lab at Mississippi State University.">
  <PageHero eyebrow="Publications" title="Research output" lede="Peer-reviewed articles and reviews. Lab members' names are in bold." />
  <section class="section">
    <div class="wrap narrow">
      <label class="visually-hidden" for="pub-q">Search publications</label>
      <input type="search" id="pub-q" placeholder="Search by title, author, or journal…" hidden />
      {years.map((y) => (
        <div class="year" data-group>
          <h2>{y}</h2>
          <ul class="pub-list">{publications.filter((p) => p.year === y).map((p) => <PubItem pub={p} year={false} />)}</ul>
        </div>
      ))}
      <p class="muted" id="pub-empty" style="padding:40px 0" hidden>No matching publications.</p>
    </div>
  </section>
</Base>
<style>
  #pub-q { margin-bottom: 24px; }
  .year { margin-top: 40px; }
  .year h2 { font-size: 1.25rem; color: var(--accent-600); margin-bottom: 8px; }
</style>
<script>
  const q = document.getElementById('pub-q') as HTMLInputElement;
  q.hidden = false;
  q.addEventListener('input', () => {
    const s = q.value.trim().toLowerCase();
    let shown = 0;
    document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
      let n = 0;
      g.querySelectorAll<HTMLElement>('.pub').forEach((li) => { li.hidden = !!s && !li.textContent!.toLowerCase().includes(s); if (!li.hidden) n++; });
      g.hidden = n === 0; shown += n;
    });
    document.getElementById('pub-empty')!.hidden = shown > 0;
  });
</script>
