---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Avatar from '../../components/Avatar.astro';
import Icon from '../../components/Icon.astro';
import { currentPeople, alumni, teams, url, shortName, clean } from '../../lib/data';

const pi = currentPeople.find((p) => p.category === 'pi');
const { Content: PiBio } = pi;
const role = (p: any) => p.role.split(' — ')[0];
const byLead = (a: any, b: any) => Number(!!b.is_lead) - Number(!!a.is_lead) || a.order - b.order;
const groups = [
  ...teams.map((t) => ({ id: t.id, eyebrow: 'Team', title: t.name, intro: clean(t.summary), members: currentPeople.filter((p) => p.team === t.id).sort(byLead) })),
  { id: 'interns', eyebrow: 'Students', title: 'Interns', intro: '', members: currentPeople.filter((p) => p.category === 'intern') },
  { id: 'alumni', eyebrow: 'Former members', title: 'Alumni', intro: '', members: alumni },
].filter((g) => g.members.length);
---
<Base title="People" description="Faculty, research associates, graduate students, interns, and alumni of the Bala Lab at Mississippi State University.">
  <PageHero eyebrow="People" title="The people behind the research" lede="Research associates, graduate students, and interns working across three teams." />

  <section class="section">
    <div class="wrap">
      <div class="pi">
        <Avatar person={pi} size={200} />
        <div>
          <span class="pill">Principal investigator</span>
          <h2>{pi.name}</h2>
          <p class="pi__role">{pi.role}</p>
          <div class="prose"><PiBio /></div>
          <div class="btn-row" style="margin-top:28px">
            <a class="btn btn--line" href={url(`/people/${pi.slug}/`)}>Full profile <Icon name="arrow" /></a>
            <a class="link" href={`mailto:${pi.email}`}>{pi.email}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {groups.map((g, i) => (
    <section class:list={['section', i % 2 === 0 && 'bg-stone']} id={g.id}>
      <div class="wrap">
        <div class="head"><div class="eyebrow">{g.eyebrow}</div><h2>{g.title}</h2>{g.intro && <p>{g.intro}</p>}</div>
        <div class="grid grid-4">
          {g.members.map((p) => (
            <a class="card person" href={url(`/people/${p.slug}/`)}>
              <Avatar person={p} size={88} />
              <h3>{shortName(p.name)}</h3>
              <p>{role(p)}</p>
              {p.is_lead && p.team !== 'pi' && <span class="pill">Team lead</span>}
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
</Base>

<style>
  .pi { display: grid; grid-template-columns: auto 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .pi h2 { margin: 16px 0 6px; }
  .pi__role { color: var(--accent-600); font-weight: 600; margin-bottom: 20px; }
  .pi .btn-row { align-items: center; gap: 24px; }
  @media (max-width: 760px) { .pi { grid-template-columns: 1fr; } }
</style>
