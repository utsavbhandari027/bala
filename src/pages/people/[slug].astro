---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Avatar from '../../components/Avatar.astro';
import PubItem from '../../components/PubItem.astro';
import { currentPeople, alumni, projects, publications, teamById, url, shortName } from '../../lib/data';

export function getStaticPaths() {
  return [...currentPeople, ...alumni]
    .filter((p) => p.category !== 'undergrad-intern')
    .map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: any };
const { Content } = p;
const team = teamById(p.team);
const myProjects = projects.filter((x) => (x.people ?? []).includes(p.slug));
const myPubs = publications.filter((x) => (x.lab_authors ?? []).includes(p.slug));
// lab_authors lets PubItem bold this person's name using their cite_names.
const articles = [...(p.first_author_articles ?? [])].sort((a, b) => b.year - a.year).map((a) => ({ ...a, lab_authors: [p.slug] }));
const timeline: any[] = p.timeline ?? [];
const interests: string[] = p.research_interests ?? [];
const chips = [['🏠', p.hometown], ['📍', p.location], ['🧰', p.position]].filter(([, v]) => v);
const hasAbout = p.hasBody || interests.length > 0 || chips.length > 0;
const L = p.links ?? {};
const links = [
  ['ORCID', L.orcid], ['Google Scholar', L.scholar], ['ResearchGate', L.researchgate], ['LinkedIn', L.linkedin],
  ['GitHub', L.github], ['MSU directory', L.directory], ['CV', L.cv],
].filter(([, v]) => v);
const name = shortName(p.name);
---
<Base title={name.replace(/^Dr\.\s*/, '')} description={`${p.name} — ${p.role}, Bala Lab, Mississippi State University.`}>
  <PageHero eyebrow={team ? team.name : p.category === 'pi' ? 'Principal investigator' : 'Bala Lab'} title={name} lede={p.program || p.role} back={{ label: 'People', href: url('/people/') }} />

  <section class="section">
    <div class="wrap">
      <div class="who">
        <Avatar person={p} size={120} />
        <ul class="contact">
          {p.email && <li><a href={`mailto:${p.email}`}>{p.email}</a></li>}
          {p.phone && <li>{p.phone}</li>}
          {p.office && <li class="muted">{p.office}</li>}
          {links.map(([label, href]) => <li><a href={href}>{label} ↗</a></li>)}
        </ul>
      </div>

      {(hasAbout || timeline.length > 0) && (
        <div class:list={['about', !(hasAbout && timeline.length > 0) && 'about--solo']}>
          {hasAbout && (
            <div>
              <div class="eyebrow">About</div>
              {(p.hasBody || interests.length > 0) && <h2>{p.category === 'pi' ? 'Biography' : 'Research Interests'}</h2>}
              {p.hasBody && <div class="prose"><Content /></div>}
              {interests.length > 0 && <div class="tags">{interests.map((r) => <span class="pill">{r}</span>)}</div>}
              {chips.length > 0 && (
                <ul class="chips">{chips.map(([icon, text]) => <li><span aria-hidden="true">{icon}</span>{text}</li>)}</ul>
              )}
            </div>
          )}
          {timeline.length > 0 && (
            <div>
              <div class="eyebrow">Education &amp; experience</div>
              <ol class="timeline">
                {timeline.map((t) => (
                  <li>
                    <span class="timeline__years">{t.years}</span>
                    <h3>{t.title}</h3>
                    <p>{t.place}{t.details && `: ${t.details}`}</p>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </div>
      )}
    </div>
  </section>

  {(articles.length > 0 || myProjects.length > 0 || myPubs.length > 0) && (
    <section class="section bg-stone">
      <div class="wrap work">
        {articles.length > 0 && (
          <div>
            <div class="head"><div class="eyebrow">Publications</div><h2>Selected first-author articles</h2></div>
            <ul class="pub-list">{articles.map((a) => <PubItem pub={a} />)}</ul>
          </div>
        )}
        {myProjects.length > 0 && (
          <div>
            <div class="head"><div class="eyebrow">Research</div><h2>Projects</h2></div>
            <ul class="rows">{myProjects.map((x) => <li style="grid-template-columns:1fr"><a class="title" href={url(`/research/projects/${x.slug}/`)}>{x.title}</a></li>)}</ul>
          </div>
        )}
        {myPubs.length > 0 && (
          <div>
            <div class="head"><div class="eyebrow">Publications</div><h2>Lab publications</h2></div>
            <ul class="pub-list">{myPubs.slice(0, 6).map((x) => <PubItem pub={x} />)}</ul>
            {myPubs.length > 6 && <a class="link" style="margin-top:20px" href={url('/publications/')}>All publications →</a>}
          </div>
        )}
      </div>
    </section>
  )}
</Base>

<style>
  .who { display: flex; align-items: center; gap: 28px; padding-bottom: 40px; margin-bottom: clamp(48px, 6vw, 72px); border-bottom: 1px solid var(--rule); }
  .contact { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: .9375rem; word-break: break-word; }
  .about { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 96px); align-items: start; }
  .about--solo { grid-template-columns: 1fr; }
  .about h2 { margin-bottom: 24px; }
  .about .prose { font-size: 1.0625rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .tags .pill { letter-spacing: .04em; text-transform: none; font-size: .8125rem; font-weight: 600; }
  .chips { list-style: none; margin: 32px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .chips li { display: inline-flex; align-items: center; gap: 8px; padding: 8px 18px; border: 1px solid var(--rule); border-radius: 999px; background: var(--stone); font-size: .875rem; font-weight: 600; }
  .timeline { list-style: none; margin: 0; padding: 0; }
  .timeline li { position: relative; padding: 0 0 36px 44px; }
  .timeline li:last-child { padding-bottom: 0; }
  .timeline li::before { content: ''; position: absolute; left: 0; top: 3px; width: 18px; height: 18px; border: 3px solid var(--accent-600); border-radius: 50%; background: var(--white); }
  .timeline li:not(:last-child)::after { content: ''; position: absolute; left: 8px; top: 29px; bottom: 6px; width: 2px; background: var(--rule); }
  .timeline__years { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .8125rem; color: var(--muted); }
  .timeline h3 { margin: 4px 0 6px; }
  .timeline p { margin: 0; color: var(--ink-2); font-size: .9375rem; }
  .work { display: grid; gap: clamp(56px, 7vw, 88px); }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .who { flex-direction: column; align-items: flex-start; } }
</style>
