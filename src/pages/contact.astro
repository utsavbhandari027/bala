---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Contact" description="Contact the Bala Lab — address, email, and phone.">
  <PageHero eyebrow="Contact" title="Get in touch" lede="Questions about our research, collaborations, or joining the lab are always welcome." />
  <section class="section">
    <div class="wrap">
      <div class="grid grid-3">
        <a class="card" href="mailto:lad425@msstate.edu"><span class="card__icon"><Icon name="mail" /></span><span class="card__meta">Email</span><h3>lad425@msstate.edu</h3></a>
        <a class="card" href="tel:6623252598"><span class="card__icon"><Icon name="phone" /></span><span class="card__meta">Phone</span><h3>(662) 325-2598</h3></a>
        <a class="card" href="https://www.google.com/maps/search/Hill+Agriculture+Building+Mississippi+State+University"><span class="card__icon"><Icon name="map-pin" /></span><span class="card__meta">Address</span>
          <h3>Hill Agriculture Building</h3><p>32 Creelman Street<br />Mississippi State, MS 39762</p></a>
      </div>
    </div>
  </section>
</Base>
