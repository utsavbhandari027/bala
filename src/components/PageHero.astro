---
import FieldArt from './FieldArt.astro';
interface Props { title: string; eyebrow?: string; lede?: string; back?: { label: string; href: string } }
const { title, eyebrow, lede, back } = Astro.props;
---
<header class="page-head on-dark">
  <FieldArt />
  <div class="wrap">
    {back && <a class="back" href={back.href}>← {back.label}</a>}
    {eyebrow && <div class="eyebrow rise">{eyebrow}</div>}
    <h1 class="rise-2" set:html={title} />
    {lede && <p class="lede rise-3" set:html={lede} />}
    <slot />
  </div>
</header>
