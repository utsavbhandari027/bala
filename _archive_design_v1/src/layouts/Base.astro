---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title?: string; description?: string }
const { title, description = 'The Bala Lab at Mississippi State University studies herbicide science, precision agriculture, remote sensing, and application technology for weed management.' } = Astro.props;
const fullTitle = title ? `${title} — Bala Lab | Mississippi State University` : 'Bala Lab | Mississippi State University';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta name="theme-color" content="#5D1725" />
  <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><circle cx="16" cy="16" r="16" fill="#5D1725"/><text x="16" y="22" text-anchor="middle" font-family="Georgia,serif" font-style="italic" font-size="18" fill="#fff">B</text></svg>')}`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;650;700;800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&display=swap" />
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main" tabindex="-1"><slot /></main>
  <Footer />
  <script>
    const $ = (s: string, r: ParentNode = document) => r.querySelector(s) as HTMLElement | null;
    const $$ = (s: string, r: ParentNode = document) => Array.from(r.querySelectorAll(s)) as HTMLElement[];

    // Header shadow on scroll
    const header = $('#site-header');
    const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
    addEventListener('scroll', onScroll, { passive: true }); onScroll();

    // Mobile menu
    const nav = $('#nav'), menuBtn = $('#menu-toggle');
    const setMenu = (open: boolean) => {
      nav?.classList.toggle('is-open', open);
      menuBtn?.setAttribute('aria-expanded', String(open));
      menuBtn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (menuBtn) menuBtn.innerHTML = open
        ? '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>'
        : '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>';
      document.body.style.overflow = open ? 'hidden' : '';
    };
    menuBtn?.addEventListener('click', () => setMenu(!nav?.classList.contains('is-open')));

    // Site search
    const sBtn = $('#search-toggle'), sPanel = $('#search-panel');
    const sInput = $('#site-search') as HTMLInputElement | null, sOut = $('#search-results');
    let index: { t: string; k: string; d: string; u: string }[] | null = null;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const render = () => {
      if (!sInput || !sOut) return;
      const q = sInput.value.trim().toLowerCase();
      if (!index || q.length < 2) { sOut.innerHTML = ''; return; }
      const hits = index.filter((r) => (r.t + ' ' + r.d).toLowerCase().includes(q)).slice(0, 12);
      sOut.innerHTML = hits.length
        ? hits.map((r) => `<li><a href="${esc(r.u)}"><span class="kind">${esc(r.k)}</span><span>${esc(r.t)}</span></a></li>`).join('')
        : '<li style="padding:12px 8px;color:var(--grey-500)">No results.</li>';
    };
    sBtn?.addEventListener('click', () => {
      if (!sPanel || !sInput) return;
      const open = sPanel.hidden;
      sPanel.hidden = !open;
      sBtn.setAttribute('aria-expanded', String(open));
      if (open) {
        sInput.focus();
        if (!index) fetch(sInput.dataset.index!).then((r) => r.json()).then((d) => { index = d; render(); });
      }
    });
    sInput?.addEventListener('input', render);
    addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      setMenu(false);
      if (sPanel && !sPanel.hidden) { sPanel.hidden = true; sBtn?.setAttribute('aria-expanded', 'false'); sBtn?.focus(); }
    });

    // Copy citation buttons
    if (navigator.clipboard) $$('.js-copy').forEach((b) => {
      b.hidden = false;
      b.addEventListener('click', () => navigator.clipboard.writeText(b.dataset.cite!).then(() => {
        const html = b.innerHTML; b.textContent = 'Copied'; setTimeout(() => (b.innerHTML = html), 1500);
      }));
    });
  </script>
</body>
</html>
