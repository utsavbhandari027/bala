---
import Avatar from './Avatar.astro';
import TeamTag from './TeamTag.astro';
import { url, shortName } from '../lib/data';
interface Props { person: any; compact?: boolean }
const { person: p, compact = false } = Astro.props;
const role = p.role.split(' — ')[0] + (p.is_lead && p.team !== 'pi' ? ' · Team Lead' : '');
---
<a class:list={['person-card', compact && 'person-card--compact']} href={url(`/people/${p.slug}/`)}>
  <Avatar person={p} size={compact ? 'sm' : ''} />
  <div>
    <h3>{shortName(p.name)}</h3>
    <div class="role">{role}</div>
    {!compact && <TeamTag team={p.team} />}
  </div>
</a>
