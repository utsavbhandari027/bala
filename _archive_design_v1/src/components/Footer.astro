        <address>
          Department of Plant and Soil Sciences<br />
          Hill Agriculture Building<br />
          32 Creelman Street<br />
          Mississippi State, MS 39762<br />
          <a href="mailto:lad425@msstate.edu">lad425@msstate.edu</a><br />
          <a href="tel:6623252598">(662) 325-2598</a>
        </address>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} Bala Lab · Mississippi State University · Last updated {updated}</span>
      <span><a href="https://www.msstate.edu/equal-opportunity">EEO Statement</a> · <a href="https://www.msstate.edu/legal">Legal</a></span>
