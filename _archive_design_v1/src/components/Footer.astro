---
import { url } from '../lib/data';
const year = new Date().getFullYear();
const updated = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={url('/')}>
          <span class="brand__mark" aria-hidden="true">B</span>
          <span class="brand__text"><span class="brand__name">Bala Lab</span><span class="brand__sub">Weed Science &amp; Precision Agriculture</span></span>
        </a>
        <p>Science-driven solutions for modern weed management in the Mid-South and beyond.</p>
        <span class="footer-msu">Mississippi State<span>University</span></span>
      </div>
      <div>
        <h2>Explore</h2>
        <ul>
          <li><a href={url('/research/')}>Research</a></li>
          <li><a href={url('/people/')}>People</a></li>
          <li><a href={url('/publications/')}>Publications</a></li>
          <li><a href={url('/opportunities/')}>Opportunities</a></li>
          <li><a href={url('/acknowledgments/')}>Acknowledgments</a></li>
        </ul>
      </div>
      <div>
        <h2>Affiliations</h2>
        <ul>
          <li><a href="https://www.msstate.edu">Mississippi State University</a></li>
          <li><a href="https://www.cals.msstate.edu">CALS</a></li>
          <li><a href="https://www.mafes.msstate.edu">MAFES</a></li>
          <li><a href="https://extension.msstate.edu">MSU Extension</a></li>
          <li><a href="https://www.dafvm.msstate.edu">DAFVM</a></li>
        </ul>
      </div>
      <div>
