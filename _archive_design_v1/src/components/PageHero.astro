---
interface Props { title: string; eyebrow?: string; lede?: string; crumbs?: { label: string; href: string }[] }
const { title, eyebrow, lede } = Astro.props;
---
<section class="page-hero on-dark">
  <div class="container">
    {eyebrow && <div class="eyebrow reveal">{eyebrow}</div>}
    <h1 class="reveal-2" set:html={title} />
    {lede && <p class="lede reveal-3" set:html={lede} />}
    <slot />
  </div>
</section>
