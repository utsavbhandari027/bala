---
import { initials, shortName, url } from '../lib/data';
interface Props { person: any; size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | ''; ring?: boolean; class?: string }
const { person, size = '', ring = false, class: cls = '' } = Astro.props;
---
<div class:list={['avatar', size && `avatar--${size}`, ring && 'avatar--ring', cls]}>
  {person?.photo
    ? <img src={url(person.photo)} alt={`Portrait of ${shortName(person.name).replace(/^Dr\.\s*/, '')}`} loading="lazy" width="600" height="600" />
    : <span aria-hidden="true">{person ? initials(person.name) : '—'}</span>}
</div>
