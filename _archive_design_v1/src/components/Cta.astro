---
import Icon from './Icon.astro';
import { url } from '../lib/data';
---
<section class="section" style="padding-top:0">
  <div class="container">
    <div class="cta on-dark">
      <div>
        <div class="eyebrow">Join the lab</div>
        <h2>We're recruiting <em>graduate students</em> and interns.</h2>
        <p>Assistantships are available for MS and PhD students in weed science, application technology, and digital agriculture. Summer internships are open to undergraduates.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--white" href={url('/opportunities/')}>See open positions <Icon name="arrow" /></a>
      </div>
    </div>
  </div>
</section>
