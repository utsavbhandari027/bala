---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Avatar from '../components/Avatar.astro';
import PubItem from '../components/PubItem.astro';
import Cta from '../components/Cta.astro';
import { researchAreas, teams, currentPeople, publications, news, personBySlug, url, fmtDate, shortName } from '../lib/data';

const students = currentPeople.filter((p) => p.category === 'student');
const interns = currentPeople.filter((p) => p.category === 'intern');
const since2024 = publications.filter((p) => p.year >= 2024).length;
const featured = [...publications].sort((a, b) => Number(!!b.featured) - Number(!!a.featured) || b.year - a.year).slice(0, 4);
const spotlight = publications.find((p) => p.id?.startsWith('palacios-zuniga-2024')) ?? publications[0];
---
<Base>
  <!-- ============ HERO ============ -->
  <section class="hero on-dark">
    <div class="container hero__grid">
      <div class="hero__copy">
        <div class="eyebrow reveal">Department of Plant and Soil Sciences · MAFES</div>
        <h1 class="reveal-2">Science-driven solutions for <em>modern weed management.</em></h1>
        <p class="hero__lede reveal-3">We combine herbicide science, precision agriculture, remote sensing, and application technology to solve real-world agricultural challenges in the Mid-South and beyond.</p>
        <div class="btn-row reveal-3">
          <a class="btn btn--white" href={url('/research/')}>Explore our research <Icon name="arrow" /></a>
          <a class="btn btn--ghost-light" href={url('/people/')}>Meet the team</a>
        </div>
      </div>
      <figure class="hero__media reveal-2">
        <img src={url('/img/hero-placeholder.svg')} alt="" width="900" height="1100" />
        <figcaption>Placeholder — replace with a real field photo</figcaption>
        <a class="hero__card" href={spotlight.doi ? `https://doi.org/${spotlight.doi}` : url('/publications/')}>
          <span class="tag">Featured paper · {spotlight.year}</span>
          <strong>{spotlight.title}</strong>
          <span class="muted"><em>{spotlight.venue}</em> {spotlight.volume}</span>
        </a>
      </figure>
    </div>
    <div class="container">
      <dl class="stats">
        <div><dt>Publications since 2000</dt><dd>200<span>+</span></dd></div>
        <div><dt>Papers since 2024</dt><dd>{since2024}</dd></div>
        <div><dt>Graduate students</dt><dd>{students.length}</dd></div>
        <div><dt>Research teams</dt><dd>{teams.length}</dd></div>
      </dl>
    </div>
  </section>

  <!-- ============ RESEARCH ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">Research</div><h2>Five connected areas of <em>weed science</em></h2></div>
        <p>From the spray nozzle to the target site in the plant and into the soil — each area informs management that stays effective.</p>
      </div>
      <ol class="areas">
        {researchAreas.map((a, i) => (
          <li>
            <a class="area" href={url(`/research/#${a.id}`)}>
              <span class="area__num">0{i + 1}</span>
              <span class="area__icon"><Icon name={a.icon} /></span>
              <span class="area__title">{a.title}</span>
              <span class="area__blurb">{a.blurb}</span>
              <span class="area__go"><Icon name="arrow" size={20} /></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ TEAMS ============ -->
  <section class="section bg-grey">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">Teams</div><h2>Three teams, <em>one program</em></h2></div>
        <a class="link-arrow" href={url('/people/')}>Meet everyone <Icon name="arrow" /></a>
      </div>
      <div class="grid grid-3">
        {teams.map((t, i) => {
          const members = currentPeople.filter((p) => p.team === t.id);
          const lead = t.lead ? personBySlug(t.lead) : null;
          return (
            <a class="team" href={url(`/people/#${t.id}`)}>
              <div class="team__top">
                <span class="team__num">Team 0{i + 1}</span>
                <span class="team__arrow"><Icon name="arrow-up-right" size={20} /></span>
              </div>
              <h3 class="team__name">{t.name}</h3>
              <p>{t.summary.replace(/\s*TODO:.*$/, '')}</p>
              <div class="team__foot">
                <div class="avatar-stack">{members.slice(0, 4).map((m) => <Avatar person={m} size="xs" />)}</div>
                <div class="team__lead">
                  <span>{lead ? shortName(lead.name) : 'Lead to be announced'}</span>
                  <span class="muted">{lead ? 'Team lead' : `${members.length} member${members.length === 1 ? '' : 's'}`}</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ============ PUBLICATIONS ============ -->
  <section class="section">
    <div class="container pubs-split">
      <div class="pubs-split__intro">
        <div class="eyebrow">Publications</div>
        <h2>Recent <em>work</em></h2>
        <p class="muted">Selected papers from the lab. Lab members are highlighted in maroon.</p>
        <a class="btn btn--ghost" href={url('/publications/')}>All publications <Icon name="arrow" /></a>
      </div>
      <ul class="pub-list">{featured.map((p) => <PubItem pub={p} compact />)}</ul>
    </div>
  </section>

  <!-- ============ NEWS ============ -->
  <section class="section bg-grey">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">News</div><h2>From the <em>lab</em></h2></div>
        <a class="link-arrow" href={url('/news/')}>All news <Icon name="arrow" /></a>
      </div>
      <div class="grid grid-3">
        {news.slice(0, 3).map((n) => (
          <a class="card" href={url(`/news/${n.slug}/`)}>
            <div class="card__body">
              <div class="card__meta"><time datetime={n.date.toISOString()}>{fmtDate(n.date)}</time><span class="tag">{n.category.replace('-', ' ')}</span></div>
              <h3>{n.title}</h3>
              <p>{n.summary}</p>
              <div class="card__foot"><span class="link-arrow">Read more <Icon name="arrow" /></span></div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="bg-grey"><Cta /></div>
</Base>

<style>
  /* Hero */
  .hero { background: var(--maroon); color: var(--white); padding: clamp(48px, 7vw, 96px) 0 0; position: relative; overflow: hidden; }
  .hero::before { content: ""; position: absolute; left: -260px; bottom: -340px; width: 760px; height: 760px; border-radius: 50%;
    border: 1px solid rgba(255,255,255,.07); box-shadow: 0 0 0 90px rgba(255,255,255,.012), 0 0 0 91px rgba(255,255,255,.05); pointer-events: none; }
  .hero__grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(32px, 6vw, 88px); align-items: center; position: relative; }
  .hero h1 { font-size: clamp(2.75rem, 6vw, 5rem); margin-bottom: 28px; }
  .hero h1 em { color: var(--maroon-200); }
  .hero__lede { font-size: 1.1875rem; line-height: 1.6; color: rgba(255,255,255,.82); max-width: 50ch; margin-bottom: 36px; }
  .hero__media { position: relative; margin: 0; }
  .hero__media img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 999px 999px var(--radius-lg) var(--radius-lg); }
  .hero__media figcaption { position: absolute; top: 46%; left: 0; right: 0; text-align: center; font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; color: var(--grey-500); }
  .hero__card { position: absolute; left: -48px; bottom: 32px; width: min(340px, 90%); display: flex; flex-direction: column; gap: 10px;
    background: var(--white); color: var(--ink); text-decoration: none; padding: 20px 22px; border-radius: var(--radius); box-shadow: var(--shadow-lg);
    transition: transform .25s var(--ease); }
  .hero__card:hover { transform: translateY(-3px); color: var(--ink); }
  .hero__card .tag { align-self: start; }
  .hero__card strong { font-size: .9375rem; line-height: 1.4; font-weight: 600; }
  .hero__card .muted { font-size: .8125rem; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); margin: clamp(56px, 7vw, 96px) 0 0; border-top: 1px solid rgba(255,255,255,.16); position: relative; }
  .stats div { padding: 28px 24px 36px 0; }
  .stats div + div { padding-left: 28px; border-left: 1px solid rgba(255,255,255,.16); }
  .stats dt { font-size: .8125rem; color: var(--maroon-200); letter-spacing: .02em; order: 2; }
  .stats dd { margin: 0 0 6px; font: 400 clamp(2.5rem, 4.5vw, 3.75rem)/1 var(--font-display); letter-spacing: -.02em; }
  .stats dd span { color: var(--maroon-300); }
  .stats div { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__media { max-width: 440px; }
    .hero__card { left: 16px; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stats > div:nth-child(odd) { padding-left: 0; border-left: 0; }
    .stats > div:nth-child(even) { padding-left: 20px; }
    .stats div:nth-child(n+3) { border-top: 1px solid rgba(255,255,255,.16); }
  }

  /* Research rows */
  .areas { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--grey-200); }
  .areas li { border-bottom: 1px solid var(--grey-200); }
  .area { display: grid; grid-template-columns: 56px 56px 1.1fr 1.6fr 48px; gap: 24px; align-items: center; padding: 26px 16px; margin: 0 -16px;
    border-radius: var(--radius); text-decoration: none; color: var(--ink); transition: background .25s var(--ease); }
  .area:hover { background: var(--maroon); color: var(--white); }
  .area__num { font: 400 1.125rem/1 var(--font-display); color: var(--grey); }
  .area__icon { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: var(--maroon-50); color: var(--maroon); transition: background .25s, color .25s; }
  .area__title { font: 500 1.625rem/1.15 var(--font-display); letter-spacing: -.01em; }
  .area__blurb { color: var(--ink-2); font-size: .9375rem; transition: color .25s; }
  .area__go { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--grey-300); color: var(--maroon); transition: all .25s var(--ease); }
  .area:hover .area__num, .area:hover .area__blurb { color: var(--maroon-200); }
  .area:hover .area__icon { background: rgba(255,255,255,.12); color: var(--white); }
  .area:hover .area__go { background: var(--white); border-color: var(--white); transform: rotate(-45deg); }
  @media (max-width: 860px) {
    .area { grid-template-columns: 48px 1fr 44px; gap: 6px 16px; padding: 20px 12px; margin: 0 -12px; }
    .area__num { display: none; }
    .area__title { font-size: 1.375rem; }
    .area__blurb { grid-column: 2 / 3; grid-row: 2; }
    .area__go { grid-column: 3; grid-row: 1 / 3; }
  }

  /* Teams */
  .team { display: flex; flex-direction: column; gap: 14px; height: 100%; padding: 32px; border-radius: var(--radius-lg); background: var(--white); border: 1px solid var(--grey-200);
    text-decoration: none; color: var(--ink); transition: all .3s var(--ease); }
  .team:hover { background: var(--maroon); border-color: var(--maroon); color: var(--white); box-shadow: var(--shadow-lg); transform: translateY(-4px); }
  .team__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .team__num { font-size: .75rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--maroon); }
  .team__arrow { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--maroon-50); color: var(--maroon); transition: all .3s var(--ease); }
  .team__name { font: 500 1.875rem/1.1 var(--font-display); letter-spacing: -.01em; margin: 0; }
  .team p { color: var(--ink-2); font-size: .9375rem; margin: 0; transition: color .3s; }
  .team__foot { margin-top: auto; padding-top: 24px; border-top: 1px solid var(--grey-200); display: flex; align-items: center; gap: 14px; transition: border-color .3s; }
  .team__lead { display: flex; flex-direction: column; font-size: .875rem; font-weight: 600; line-height: 1.35; }
  .team__lead .muted { font-weight: 400; font-size: .8125rem; }
  .team:hover .team__num, .team:hover .team__lead .muted { color: var(--maroon-200); }
  .team:hover p { color: rgba(255,255,255,.8); }
  .team:hover .team__arrow { background: var(--white); }
  .team:hover .team__foot { border-color: rgba(255,255,255,.2); }
  .team:hover :global(.avatar-stack .avatar) { box-shadow: 0 0 0 3px var(--maroon); }

  /* Publications split */
  .pubs-split { display: grid; grid-template-columns: 1fr 1.7fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .pubs-split__intro { position: sticky; top: 120px; }
  .pubs-split__intro p { max-width: 32ch; margin-bottom: 28px; }
  @media (max-width: 860px) { .pubs-split { grid-template-columns: 1fr; } .pubs-split__intro { position: static; } }
</style>
