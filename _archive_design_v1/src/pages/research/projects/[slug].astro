---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import PersonCard from '../../../components/PersonCard.astro';
import TeamTag from '../../../components/TeamTag.astro';
import { projects, personBySlug, url } from '../../../lib/data';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: any };
const { Content } = p;
const team = (p.people ?? []).map(personBySlug).filter(Boolean);
---
<Base title={p.title} description={p.summary}>
  <PageHero eyebrow="Project" title={p.title} lede={p.summary} />
  <section class="section" style="padding-top:56px">
    <div class="container">
      <dl class="meta-strip">
        <div><dt>Status</dt><dd><span class:list={['tag', p.status !== 'active' && 'tag--grey']}>{p.status}</span></dd></div>
        <div><dt>Teams</dt><dd class="tags">{(p.teams ?? []).map((t: string) => <TeamTag team={t} />)}</dd></div>
        <div><dt>Period</dt><dd>{p.start}{p.end ? `–${p.end}` : '–present'}</dd></div>
        <div><dt>Funding</dt><dd>{p.funding || '—'}</dd></div>
      </dl>
      <div class="proj-body">
        <figure><img src={url(p.image)} alt="" /><figcaption>Placeholder — replace with a real project photo.</figcaption></figure>
        <div class="prose"><Content /></div>
      </div>
      {team.length > 0 && (
        <div style="margin-top:var(--section)">
          <div class="eyebrow">Team members</div>
          <div class="people-grid">{team.map((m: any) => <PersonCard person={m} />)}</div>
        </div>
      )}
    </div>
  </section>
</Base>
<style>
  .meta-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin: 0 0 56px; padding: 24px 28px; background: var(--grey-50); border: 1px solid var(--grey-200); border-radius: var(--radius); }
  .meta-strip dt { font-size: .6875rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--grey-500); margin-bottom: 8px; }
  .meta-strip dd { margin: 0; font-weight: 500; }
  .proj-body { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(32px, 6vw, 88px); align-items: start; }
  .proj-body figure { margin: 0; }
  .proj-body img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-lg); }
  figcaption { font-size: .8125rem; color: var(--grey-500); margin-top: 10px; }
  @media (max-width: 860px) { .meta-strip { grid-template-columns: 1fr 1fr; } .proj-body { grid-template-columns: 1fr; } }
</style>
