---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PubItem from '../../components/PubItem.astro';
import TeamTag from '../../components/TeamTag.astro';
import Icon from '../../components/Icon.astro';
import Cta from '../../components/Cta.astro';
import { researchAreas, projects, publications, teams, url, inlineMd } from '../../lib/data';
---
<Base title="Research" description="Research areas and projects of the Bala Lab — herbicide physiology, precision weed management, application technology, environmental fate, and alternative weed control.">
  <PageHero eyebrow="Research" title="From the nozzle <em>to the soil</em>"
    lede="Weeds adapt quickly to the tools used against them. The lab follows a herbicide from the spray nozzle to its target site in the plant and into the soil, and uses that understanding to design management that stays effective. <span class='todo'>TODO: PI to confirm wording</span>">
    <nav class="jump" aria-label="Research areas">
      {researchAreas.map((a, i) => <a href={`#${a.id}`}><span>0{i + 1}</span>{a.title}</a>)}
    </nav>
  </PageHero>

  <div class="container">
    {researchAreas.map((a, i) => {
      const rel = projects.filter((p) => (p.areas ?? []).includes(a.id));
      const pubs = publications.filter((p) => (p.areas ?? []).includes(a.id)).slice(0, 2);
      return (
        <section class:list={['area-row', i % 2 && 'flip']} id={a.id}>
          <figure class="area-row__media">
            <img src={url(a.image)} alt="" loading="lazy" />
            <span class="area-row__icon"><Icon name={a.icon} size={28} /></span>
          </figure>
          <div class="area-row__text">
            <div class="eyebrow">Area 0{i + 1}</div>
            <h2>{a.title}</h2>
            <div class="prose" set:html={`<p>${inlineMd(a.description)}</p>`} />
            <h3 class="mini">Key questions</h3>
            <ul class="qs">{a.questions.map((q: string) => <li>{q}</li>)}</ul>
            {rel.length > 0 && (<>
              <h3 class="mini">Related projects</h3>
              <div class="rel">{rel.map((p) => <a class="tag" href={url(`/research/projects/${p.slug}/`)}>{p.title}</a>)}</div>
            </>)}
            {pubs.length > 0 && (<>
              <h3 class="mini">Key papers</h3>
              <ul class="pub-list">{pubs.map((p) => <PubItem pub={p} compact />)}</ul>
            </>)}
          </div>
        </section>
      );
    })}
  </div>

  <section class="section bg-grey" id="projects">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">Projects</div><h2>Current and <em>completed</em> projects</h2></div>
        <div class="segmented" id="project-filter" hidden>
          <button type="button" data-v="all" aria-pressed="true">All</button>
          {teams.map((t) => <button type="button" data-v={t.id} aria-pressed="false">{t.short}</button>)}
          <button type="button" data-v="active" aria-pressed="false">Active</button>
          <button type="button" data-v="completed" aria-pressed="false">Completed</button>
        </div>
      </div>
      <div class="grid grid-3">
        {projects.map((p) => (
          <a class="card" href={url(`/research/projects/${p.slug}/`)} data-project={`${(p.teams ?? []).join(' ')} ${p.status}`}>
            <div class="card__media"><img src={url(p.image)} alt="" loading="lazy" /></div>
            <div class="card__body">
              <div class="card__meta"><span class:list={['tag', p.status !== 'active' && 'tag--grey']}>{p.status}</span><span>{p.start}{p.end ? `–${p.end}` : '–present'}</span></div>
              <h3>{p.title}</h3>
              <p>{p.summary}</p>
              <div class="card__foot tags">{(p.teams ?? []).map((t: string) => <TeamTag team={t} />)}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <div class="bg-grey"><Cta /></div>
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 40px; }
  .jump a { display: inline-flex; gap: 10px; align-items: center; height: 40px; padding: 0 16px; border-radius: 999px; border: 1px solid rgba(255,255,255,.25); color: var(--white); text-decoration: none; font-size: .875rem; font-weight: 500; transition: background .2s, border-color .2s; }
  .jump a span { color: var(--maroon-200); font-family: var(--font-display); }
  .jump a:hover { background: rgba(255,255,255,.1); border-color: var(--white); color: var(--white); }
  .area-row { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(32px, 6vw, 96px); align-items: start; padding: var(--section) 0; border-bottom: 1px solid var(--grey-200); }
  .area-row:last-child { border-bottom: 0; }
  .area-row.flip .area-row__media { order: 2; }
  .area-row__media { position: sticky; top: 110px; margin: 0; }
  .area-row__media img { width: 100%; aspect-ratio: 5 / 4; object-fit: cover; border-radius: var(--radius-lg); }
  .area-row__icon { position: absolute; left: 24px; bottom: -28px; width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center; background: var(--maroon); color: var(--white); box-shadow: 0 0 0 6px var(--white); }
  .area-row h2 { margin-bottom: 24px; }
  .mini { font-size: .75rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--grey-500); margin: 36px 0 14px; }
  .qs { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .qs li { position: relative; padding-left: 26px; color: var(--ink-2); }
  .qs li::before { content: ""; position: absolute; left: 0; top: .6em; width: 12px; height: 1.5px; background: var(--maroon); }
  .rel { display: flex; flex-wrap: wrap; gap: 8px; }
  .rel .tag { height: 32px; padding: 0 14px; text-decoration: none; }
  .rel .tag:hover { background: var(--maroon); color: var(--white); }
  @media (max-width: 900px) { .area-row { grid-template-columns: 1fr; } .area-row.flip .area-row__media { order: 0; } .area-row__media { position: static; } }
</style>

<script>
  const bar = document.getElementById('project-filter');
  if (bar) {
    bar.hidden = false;
    bar.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button'); if (!b) return;
      bar.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const v = b.dataset.v!;
      document.querySelectorAll<HTMLElement>('[data-project]').forEach((c) => (c.hidden = v !== 'all' && !c.dataset.project!.split(' ').includes(v)));
    });
  }
</script>
