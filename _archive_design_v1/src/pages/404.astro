---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/data';
---
<Base title="Page not found">
  <PageHero eyebrow="404" title="Page <em>not found</em>" lede="The page you were looking for has moved or does not exist.">
    <div class="btn-row" style="margin-top:32px"><a class="btn btn--white" href={url('/')}>Back to home <Icon name="arrow" /></a></div>
  </PageHero>
</Base>
