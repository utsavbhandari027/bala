---
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import TeamTag from '../../components/TeamTag.astro';
import PersonCard from '../../components/PersonCard.astro';
import PubItem from '../../components/PubItem.astro';
import Icon from '../../components/Icon.astro';
import { people, projects, publications, teamById, url, shortName } from '../../lib/data';

export function getStaticPaths() {
  return people.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: any };
const { Content } = p;
const team = teamById(p.team);
const myProjects = projects.filter((x) => (x.people ?? []).includes(p.slug));
const myPubs = publications.filter((x) => (x.lab_authors ?? []).includes(p.slug));
const others = people.filter((o) => o.team === p.team && o.slug !== p.slug && o.status !== 'alumni');
const L = p.links ?? {};
const links = [
  ['ORCID', L.orcid], ['Google Scholar', L.scholar], ['ResearchGate', L.researchgate], ['LinkedIn', L.linkedin],
  ['GitHub', L.github], ['MSU directory', L.directory], ['CV (PDF)', L.cv],
].filter(([, v]) => v);
const sections = [
  ['Teaching', p.teaching], ['Education', (p.education ?? []).map((e: any) => `${e.degree}, ${e.institution}${e.year ? ', ' + e.year : ''}`)],
  ['Awards', p.awards], ['Memberships', p.memberships],
].filter(([, v]) => v && v.length);
---
<Base title={shortName(p.name).replace(/^Dr\.\s*/, '')} description={`${p.name} — ${p.role}, Bala Lab, Mississippi State University.`}>
  <section class="profile-hero on-dark">
    <div class="container">
      <a class="back" href={url('/people/')}><Icon name="arrow-left" size={16} /> All people</a>
    </div>
  </section>
  <div class="container">
    <div class="profile">
      <aside class="profile__side">
        <Avatar person={p} size="lg" ring class="profile__avatar" />
        <h1>{shortName(p.name)}</h1>
        <p class="profile__role">{p.role}</p>
        <TeamTag team={p.team} />
        {p.program && <p class="profile__meta">{p.program}{p.start_year && ` · since ${p.start_year}`}</p>}
        {p.department && <p class="profile__meta">{p.department}</p>}
        <ul class="profile__contact">
          {p.email && <li><Icon name="mail" size={18} /><a href={`mailto:${p.email}`}>{p.email}</a></li>}
          {p.phone && <li><Icon name="phone" size={18} /><a href={`tel:${p.phone.replace(/\D/g, '')}`}>{p.phone}</a></li>}
          {p.office && <li><Icon name="building" size={18} /><span>{p.office}</span></li>}
          {links.map(([label, href]) => <li><Icon name="link" size={18} /><a href={href}>{label}</a></li>)}
        </ul>
        {!p.email && !links.length && <p class="profile__meta"><span class="todo">TODO</span> Email and academic links</p>}
      </aside>

      <div class="profile__main">
        <section>
          <h2 class="profile__h">About</h2>
          <div class="prose lead-text"><Content /></div>
        </section>

        {p.research_interests?.length > 0 && (
          <section>
            <h2 class="profile__h">Research focus</h2>
            <div class="tags">{p.research_interests.map((r: string) => <span class="tag tag--grey big">{r}</span>)}</div>
          </section>
        )}

        {myProjects.length > 0 && (
          <section>
            <h2 class="profile__h">Projects</h2>
            <div class="proj-list">
              {myProjects.map((x) => (
                <a href={url(`/research/projects/${x.slug}/`)} class="proj">
                  <span><strong>{x.title}</strong><span class="muted">{x.summary}</span></span>
                  <span class="tag">{x.status}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {myPubs.length > 0 && (
          <section>
            <h2 class="profile__h">Publications <span class="count">{myPubs.length}</span></h2>
            <ul class="pub-list">{myPubs.slice(0, 8).map((x) => <PubItem pub={x} compact />)}</ul>
            {myPubs.length > 8 && <a class="link-arrow" style="margin-top:20px" href={url('/publications/')}>All publications <Icon name="arrow" /></a>}
          </section>
        )}

        {sections.map(([title, items]) => (
          <section>
            <h2 class="profile__h">{title}</h2>
            <ul class="plain-list">{(items as string[]).map((i) => <li>{i}</li>)}</ul>
          </section>
        ))}
      </div>
    </div>
  </div>

  {team && others.length > 0 && (
    <section class="section bg-grey" style="margin-top:var(--section)">
      <div class="container">
        <div class="section-head"><div><div class="eyebrow">Also on the team</div><h2>{team.name}</h2></div>
          <a class="link-arrow" href={url(`/people/#${team.id}`)}>View team <Icon name="arrow" /></a></div>
        <div class="people-grid">{others.slice(0, 4).map((o) => <PersonCard person={o} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .profile-hero { background: var(--maroon); height: 200px; padding-top: 32px; position: relative; overflow: hidden; }
  .profile-hero::after { content: ""; position: absolute; right: -120px; top: -260px; width: 520px; height: 520px; border-radius: 50%; border: 1px solid rgba(255,255,255,.08); box-shadow: 0 0 0 70px rgba(255,255,255,.006), 0 0 0 71px rgba(255,255,255,.06); }
  .back { display: inline-flex; align-items: center; gap: 8px; color: var(--maroon-200); text-decoration: none; font-size: .875rem; font-weight: 500; position: relative; z-index: 1; }
  .back:hover { color: var(--white); }
  .profile { display: grid; grid-template-columns: 340px 1fr; gap: clamp(40px, 6vw, 96px); }
  .profile__side { margin-top: -100px; position: relative; z-index: 2; }
  .profile__side :global(.profile__avatar) { box-shadow: 0 0 0 6px var(--white), var(--shadow-lg); margin-bottom: 28px; }
  .profile__side h1 { font-size: clamp(2rem, 3vw, 2.5rem); margin-bottom: 8px; }
  .profile__role { color: var(--maroon); font-weight: 600; margin-bottom: 14px; line-height: 1.4; }
  .profile__meta { color: var(--grey-500); font-size: .9375rem; margin: 14px 0 0; }
  .profile__contact { list-style: none; padding: 24px 0 0; margin: 24px 0 0; border-top: 1px solid var(--grey-200); display: grid; gap: 12px; font-size: .9375rem; }
  .profile__contact li { display: flex; align-items: center; gap: 12px; color: var(--ink-2); }
  .profile__contact :global(svg) { color: var(--maroon); flex: none; }
  .profile__contact a { color: var(--ink); text-decoration: none; word-break: break-all; }
  .profile__contact a:hover { color: var(--maroon); text-decoration: underline; }
  .profile__main { padding-top: 56px; display: grid; gap: 56px; align-content: start; }
  .profile__h { font: 600 .75rem/1 var(--font-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--maroon); margin: 0 0 20px; display: flex; align-items: center; gap: 10px; }
  .profile__h .count { background: var(--maroon-50); padding: 3px 8px; border-radius: 999px; letter-spacing: 0; }
  .lead-text { font-size: 1.125rem; }
  .tag.big { height: 32px; padding: 0 14px; font-size: .8125rem; font-weight: 500; }
  .proj-list { display: grid; gap: 10px; }
  .proj { display: flex; justify-content: space-between; gap: 24px; align-items: center; padding: 18px 20px; border: 1px solid var(--grey-200); border-radius: var(--radius); text-decoration: none; color: var(--ink); transition: border-color .2s, background .2s; }
  .proj:hover { border-color: var(--maroon-200); background: var(--maroon-50); color: var(--ink); }
  .proj strong { display: block; margin-bottom: 2px; }
  .proj .muted { font-size: .9375rem; }
  .plain-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--grey-200); }
  .plain-list li { padding: 12px 0; border-bottom: 1px solid var(--grey-200); color: var(--ink-2); }
  @media (max-width: 900px) {
    .profile { grid-template-columns: 1fr; }
    .profile-hero { height: 150px; }
    .profile__side :global(.avatar--lg) { --size: 160px; }
    .profile__main { padding-top: 0; }
  }
</style>
