---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { news, url, fmtDate } from '../../lib/data';
const [lead, ...rest] = news;
---
<Base title="News" description="News from the Bala Lab at Mississippi State University.">
  <PageHero eyebrow="News" title="Lab <em>news</em>" lede="Publications, awards, conferences, field days, and new members." />
  <section class="section" style="padding-top:56px">
    <div class="container">
      {lead && (
        <a class="lead-story" href={url(`/news/${lead.slug}/`)}>
          <div class="card__meta"><time>{fmtDate(lead.date, true)}</time><span class="tag">{lead.category.replace('-', ' ')}</span></div>
          <h2>{lead.title}</h2>
          <p>{lead.summary}</p>
          <span class="link-arrow">Read story <Icon name="arrow" /></span>
        </a>
      )}
      <ul class="news-list">
        {rest.slice(0, 9).map((n) => (
          <li><a href={url(`/news/${n.slug}/`)}>
            <time>{fmtDate(n.date)}</time>
            <span class="tag">{n.category.replace('-', ' ')}</span>
            <span class="t"><strong>{n.title}</strong><span class="muted">{n.summary}</span></span>
            <span class="go"><Icon name="arrow" size={18} /></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
<style>
  .lead-story { display: block; padding: clamp(28px, 4vw, 56px); border-radius: var(--radius-lg); background: var(--maroon-50); border: 1px solid var(--maroon-100); text-decoration: none; color: var(--ink); margin-bottom: 48px; transition: background .25s; }
  .lead-story:hover { background: var(--maroon-100); color: var(--ink); }
  .lead-story h2 { margin: 18px 0 14px; max-width: 24ch; }
  .lead-story p { color: var(--ink-2); max-width: 60ch; }
  .news-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--grey-200); }
  .news-list li { border-bottom: 1px solid var(--grey-200); }
  .news-list a { display: grid; grid-template-columns: 120px 120px 1fr 40px; gap: 24px; align-items: center; padding: 24px 12px; margin: 0 -12px; border-radius: var(--radius); text-decoration: none; color: var(--ink); transition: background .2s; }
  .news-list a:hover { background: var(--grey-50); color: var(--ink); }
  .news-list time { font-size: .875rem; color: var(--grey-500); }
  .news-list .tag { justify-self: start; }
  .news-list .t { display: flex; flex-direction: column; gap: 2px; }
  .news-list .t .muted { font-size: .9375rem; }
  .news-list .go { color: var(--maroon); }
  @media (max-width: 760px) { .news-list a { grid-template-columns: 1fr; gap: 8px; } .news-list .go { display: none; } }
</style>
